# Port the API listens on.
PORT=5000

# Deployed Anchor program. Must match the frontend NEXT_PUBLIC_PROGRAM_ID.
PROGRAM_ID=6p26MgeSFbR7UFdrsUU62sbNH8Zh1bY59ob8NmfdibBc

# Cluster used for the RPC connection: devnet | testnet | mainnet-beta
SOLANA_NETWORK=devnet

# Optional custom RPC endpoint. Falls back to the public cluster URL.
# SOLANA_RPC_URL=

# HMAC key used to sign QR payloads. Anyone holding this can forge attendance
# codes, so generate a fresh one per deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to boot in production while this is still the example value.
QR_SECRET=super_secret_hmac_key_change_in_production

# How long a QR code stays valid, in seconds.
QR_EXPIRY_SECONDS=60

# Maximum distance from the classroom coordinates a student may check in from.
ALLOWED_RADIUS_METERS=50

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
