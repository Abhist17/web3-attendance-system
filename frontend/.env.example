# Base URL of the Express backend, including the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Deployed Anchor program. Must match backend PROGRAM_ID and the address in
# lib/idl/attendance.json.
NEXT_PUBLIC_PROGRAM_ID=6p26MgeSFbR7UFdrsUU62sbNH8Zh1bY59ob8NmfdibBc

# Cluster the wallet connects to: devnet | testnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Optional custom RPC endpoint. Falls back to the public cluster URL.
# NEXT_PUBLIC_SOLANA_RPC_URL=
